<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <AssemblyName>LCARSutilities</AssemblyName>
    <RootNamespace>LCARSutilities</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <StartupObject>LCARSutilities.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="System.Security" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Web" />
    <!-- Built by tools/Build-LCARS.ps1 (LCARSbuttons) before this project. -->
    <Reference Include="LCARS">
      <HintPath>..\..\LCARSbuttons\LCARSbuttons\bin\Debug\LCARS.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>
</Project>
