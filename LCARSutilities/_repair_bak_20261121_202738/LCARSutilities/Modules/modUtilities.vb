' LCARSutilities/LCARSutilities/Modules/modUtilities.vb
Option Strict On
Option Explicit On Imports System.Diagnostics
Imports System.Drawing
Imports System.Windows.Forms
Imports LCARS.Controls ''' <summary>
''' Shared chrome helpers for floating LCARS utilities (fixed size, draggable, never fill the hole).
''' </summary>
Public Module modUtilities Friend Const UtilityFontName As String = "Arial Narrow" Friend Const UtilityMargin As Integer = 12 Friend Const UtilityButtonHeight As Integer = 28 Private Const CascadeStep As Integer = 40 Private cascadeIndex As Integer = 0 Private dragForm As Form = Nothing Private dragGrab As Point = Point.Empty Private dragActive As Boolean = False ''' <summary>Floating fixed-size utility form — never binds to the desktop hole.</summary> Friend Sub InitUtilityFormFloating(ByVal frm As LCARS.LCARSForm, ByVal clientWidth As Integer, ByVal clientHeight As Integer) frm.Text = "LCARS" frm.BackColor = Color.Black frm.FormBorderStyle = FormBorderStyle.None frm.ControlBox = False frm.MaximizeBox = False frm.MinimizeBox = False frm.ShowInTaskbar = True frm.TopMost = False frm.StartPosition = FormStartPosition.Manual frm.BindToWorkingArea = False frm.RegisterWithLcarsShellEnabled = True frm.WindowState = FormWindowState.Normal frm.ClientSize = New Size(Math.Max(200, clientWidth), Math.Max(160, clientHeight)) Dim wa As Rectangle = Screen.FromPoint(Cursor.Position).WorkingArea Dim baseX As Integer = wa.Left + Math.Max(0, (wa.Width - frm.Width) \ 2) Dim baseY As Integer = wa.Top + Math.Max(0, (wa.Height - frm.Height) \ 2) Dim slot As Integer = cascadeIndex Mod 8 cascadeIndex += 1 Dim x As Integer = baseX + slot * CascadeStep Dim y As Integer = baseY + slot * CascadeStep If x + frm.Width > wa.Right Then x = Math.Max(wa.Left, wa.Right - frm.Width) If y + frm.Height > wa.Bottom Then y = Math.Max(wa.Top, wa.Bottom - frm.Height) frm.Location = New Point(x, y) End Sub ''' <summary>Compatibility alias for Timer / Screenshot call sites.</summary> Friend Sub InitUtilityForm(ByVal frm As LCARS.LCARSForm, ByVal clientWidth As Integer, ByVal clientHeight As Integer) InitUtilityFormFloating(frm, clientWidth, clientHeight) End Sub ''' <summary> ''' Title-bar drag via MouseMove (works with touch). Title must raise MouseDown — ''' FlatButton Clickable must be True or OnMouseDown is swallowed. ''' </summary> Friend Sub WireUtilityTitleDrag(ByVal title As Control, ByVal frm As Form) If title Is Nothing OrElse frm Is Nothing Then Return AddHandler title.MouseDown, AddressOf TitleDrag_MouseDown AddHandler title.MouseMove, AddressOf TitleDrag_MouseMove AddHandler title.MouseUp, AddressOf TitleDrag_MouseUp title.Tag = frm End Sub Private Sub TitleDrag_MouseDown(ByVal sender As Object, ByVal e As MouseEventArgs) If e.Button <> MouseButtons.Left Then Return Dim title As Control = TryCast(sender, Control) If title Is Nothing Then Return Dim frm As Form = TryCast(title.Tag, Form) If frm Is Nothing Then frm = title.FindForm() If frm Is Nothing Then Return dragForm = frm dragGrab = New Point(Control.MousePosition.X - frm.Left, Control.MousePosition.Y - frm.Top) dragActive = True Try title.Capture = True Catch End Try End Sub Private Sub TitleDrag_MouseMove(ByVal sender As Object, ByVal e As MouseEventArgs) If Not dragActive OrElse dragForm Is Nothing Then Return If (Control.MouseButtons And MouseButtons.Left) = 0 Then TitleDrag_MouseUp(sender, e) Return End If Dim nx As Integer = Control.MousePosition.X - dragGrab.X Dim ny As Integer = Control.MousePosition.Y - dragGrab.Y Dim wa As Rectangle = Screen.FromControl(dragForm).WorkingArea If nx + dragForm.Width < wa.Left + 40 Then nx = wa.Left + 40 - dragForm.Width If ny < wa.Top Then ny = wa.Top If nx > wa.Right - 40 Then nx = wa.Right - 40 If ny > wa.Bottom - 40 Then ny = wa.Bottom - 40 dragForm.Location = New Point(nx, ny) End Sub Private Sub TitleDrag_MouseUp(ByVal sender As Object, ByVal e As MouseEventArgs) dragActive = False dragForm = Nothing Dim title As Control = TryCast(sender, Control) If title IsNot Nothing Then Try title.Capture = False Catch End Try End If End Sub Friend Function MakeUtilityTitle(ByVal parent As Control, ByVal text As String, ByVal width As Integer) As FlatButton Dim title As New FlatButton() title.ButtonText = text title.Text = text ' Clickable must be True or FlatButton swallows MouseDown (breaks tablet drag). title.Clickable = True title.Beeping = False title.Color = LCARS.LCARScolorStyles.StaticTan title.ButtonTextAlign = ContentAlignment.MiddleLeft title.Location = New Point(UtilityMargin, UtilityMargin) title.Size = New Size(width, UtilityButtonHeight) parent.Controls.Add(title) Dim hostForm As Form = TryCast(parent, Form) If hostForm Is Nothing AndAlso parent IsNot Nothing Then hostForm = parent.FindForm() If hostForm IsNot Nothing Then WireUtilityTitleDrag(title, hostForm) Return title End Function Friend Function MakeUtilityButton(ByVal parent As Control, ByVal text As String, ByVal x As Integer, ByVal y As Integer, ByVal width As Integer, ByVal height As Integer, ByVal buttonColor As LCARS.LCARScolorStyles, ByVal handler As EventHandler) As FlatButton Dim btn As New FlatButton() btn.ButtonText = text btn.Text = text btn.Clickable = True btn.Beeping = True btn.Color = buttonColor btn.Location = New Point(x, y) btn.Size = New Size(width, height) AddHandler btn.Click, handler parent.Controls.Add(btn) Return btn End Function Friend Function MakeUtilityLabel(ByVal parent As Control, ByVal x As Integer, ByVal y As Integer, ByVal width As Integer, ByVal height As Integer, ByVal fontSize As Single) As Label Dim lbl As New Label() lbl.ForeColor = Color.Orange lbl.BackColor = Color.Black lbl.Font = New Font(UtilityFontName, fontSize, FontStyle.Regular, GraphicsUnit.Point) lbl.Location = New Point(x, y) lbl.Size = New Size(width, height) parent.Controls.Add(lbl) Return lbl End Function Friend Sub OpenUrlInLcarsBrowser(ByVal url As String) If String.IsNullOrEmpty(url) Then Return Dim browser As String = IO.Path.Combine(Application.StartupPath, "LCARSWebBrowser.exe") Try If IO.File.Exists(browser) Then Dim psi As New ProcessStartInfo() psi.FileName = browser psi.Arguments = """" & url & """" psi.WorkingDirectory = Application.StartupPath psi.UseShellExecute = True Process.Start(psi) Else Process.Start(New ProcessStartInfo() With {.FileName = url, .UseShellExecute = True}) End If Catch End Try End Sub
End Module
