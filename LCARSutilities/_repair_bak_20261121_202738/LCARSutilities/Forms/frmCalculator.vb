Public Class frmCalculator Inherits LCARS.LCARSForm Private Enum CalcUiMode Basic = 0 Sci = 1 Graph = 2 End Enum Private Const FormWidth As Integer = 780 Private Const FormHeight As Integer = 560 Private Const KeyFontNormal As Single = 16.0F Private Const KeyFontOperator As Single = 22.0F Private Const KeyFontName As String = "Arial Narrow" Private Const GraphKeypadWidth As Integer = 300 Private Const CloseButtonHeight As Integer = 32 Private currentMode As CalcUiMode = CalcUiMode.Sci Private angleMode As CalcEngine.AngleMode = CalcEngine.AngleMode.Degrees Private expr As String = "" Private ans As Double = 0 Private memory As Double = 0 Private layoutBusy As Boolean = False Private titleBar As LCARS.Controls.FlatButton Private lblDisplay As Label Private lblStatus As Label Private pnlKeys As Panel Private pnlGraph As Panel Private pnlGraphKeys As Panel Private picGraph As GraphCanvas Private txtY1 As TextBox Private txtXmin As TextBox Private txtXmax As TextBox Private txtYmin As TextBox Private txtYmax As TextBox Private lblY1 As Label Private lblTrace As Label Private fbModeBasic As LCARS.Controls.FlatButton Private fbModeSci As LCARS.Controls.FlatButton Private fbModeGraph As LCARS.Controls.FlatButton Private fbDegRad As LCARS.Controls.FlatButton Private fbClose As LCARS.Controls.FlatButton Private fbPlot As LCARS.Controls.FlatButton Private fbZstd As LCARS.Controls.FlatButton Private fbZfit As LCARS.Controls.FlatButton Private fbTraceLeft As LCARS.Controls.FlatButton Private fbTraceRight As LCARS.Controls.FlatButton Private fbTable As LCARS.Controls.FlatButton Private lblXmin As Label Private lblXmax As Label Private lblYmin As Label Private lblYmax As Label Private xmin As Double = -10 Private xmax As Double = 10 Private ymin As Double = -10 Private ymax As Double = 10 Private y1Expr As String = "" Private traceX As Double = 0 Private graphPoints As New List(Of PointF)() Private graphOk As Boolean = False Public Sub New() MyBase.New() modUtilities.InitUtilityFormFloating(Me, FormWidth, FormHeight) BuildChrome() AddHandler Me.Resize, AddressOf OnFormResize AddHandler Me.Shown, AddressOf OnFormShown ShowMode(CalcUiMode.Sci) End Sub Private Sub OnFormShown(ByVal sender As Object, ByVal e As EventArgs) LayoutChrome() End Sub Private Sub OnFormResize(ByVal sender As Object, ByVal e As EventArgs) LayoutChrome() End Sub Private Sub BuildChrome() Dim m As Integer = modUtilities.UtilityMargin titleBar = modUtilities.MakeUtilityTitle(Me, "CALCULATOR", 200) fbModeBasic = StyleModeButton(modUtilities.MakeUtilityButton(Me, "BASIC", m, 40, 90, 26, LCARS.LCARScolorStyles.PrimaryFunction, Sub(s As Object, e As EventArgs) ShowMode(CalcUiMode.Basic))) fbModeSci = StyleModeButton(modUtilities.MakeUtilityButton(Me, "SCI", m + 96, 40, 90, 26, LCARS.LCARScolorStyles.Orange, Sub(s As Object, e As EventArgs) ShowMode(CalcUiMode.Sci))) fbModeGraph = StyleModeButton(modUtilities.MakeUtilityButton(Me, "GRAPH", m + 192, 40, 100, 26, LCARS.LCARScolorStyles.PrimaryFunction, Sub(s As Object, e As EventArgs) ShowMode(CalcUiMode.Graph))) fbDegRad = StyleModeButton(modUtilities.MakeUtilityButton(Me, "DEG", m + 300, 40, 70, 26, LCARS.LCARScolorStyles.MiscFunction, AddressOf ToggleAngleMode)) lblDisplay = modUtilities.MakeUtilityLabel(Me, m, 70, 200, 48, 30.0F) lblDisplay.TextAlign = ContentAlignment.MiddleRight lblDisplay.BorderStyle = BorderStyle.FixedSingle lblDisplay.Text = "0" lblStatus = modUtilities.MakeUtilityLabel(Me, m, 120, 200, 18, 12.0F) lblStatus.TextAlign = ContentAlignment.MiddleLeft lblStatus.Text = "DEG · ANS=0 · M=0" pnlKeys = New Panel() pnlKeys.BackColor = Color.Black Controls.Add(pnlKeys) pnlGraph = New Panel() pnlGraph.BackColor = Color.Black pnlGraph.Visible = False Controls.Add(pnlGraph) BuildGraphPanel() fbClose = modUtilities.MakeUtilityButton(Me, "CLOSE", m, 100, 200, CloseButtonHeight, LCARS.LCARScolorStyles.FunctionOffline, Sub(s As Object, e As EventArgs) Close()) ApplyKeyFont(fbClose, "CLOSE") KeyPreview = True AddHandler Me.KeyDown, AddressOf OnFormKeyDown AddHandler Me.KeyPress, AddressOf OnFormKeyPress End Sub Private Function StyleModeButton(ByVal btn As LCARS.Controls.FlatButton) As LCARS.Controls.FlatButton ApplyKeyFont(btn, btn.ButtonText) Return btn End Function Private Sub BuildGraphPanel() lblY1 = modUtilities.MakeUtilityLabel(pnlGraph, 0, 0, 40, 24, 13.0F) lblY1.Text = "Y1=" txtY1 = New TextBox() txtY1.BackColor = Color.FromArgb(20, 20, 20) txtY1.ForeColor = Color.Orange txtY1.BorderStyle = BorderStyle.FixedSingle txtY1.Font = New Font(KeyFontName, 14.0!, FontStyle.Bold) txtY1.Text = y1Expr pnlGraph.Controls.Add(txtY1) fbPlot = ApplyNamed(modUtilities.MakeUtilityButton(pnlGraph, "PLOT", 0, 0, 80, 26, LCARS.LCARScolorStyles.PrimaryFunction, Sub(s As Object, e As EventArgs) PlotGraph()), "PLOT") fbZstd = ApplyNamed(modUtilities.MakeUtilityButton(pnlGraph, "ZSTD", 0, 0, 70, 26, LCARS.LCARScolorStyles.MiscFunction, Sub(s As Object, e As EventArgs) ZoomStandard()), "ZSTD") fbZfit = ApplyNamed(modUtilities.MakeUtilityButton(pnlGraph, "ZFIT", 0, 0, 70, 26, LCARS.LCARScolorStyles.MiscFunction, Sub(s As Object, e As EventArgs) ZoomFit()), "ZFIT") AddWinField("Xmin", xmin, lblXmin, txtXmin) AddWinField("Xmax", xmax, lblXmax, txtXmax) AddWinField("Ymin", ymin, lblYmin, txtYmin) AddWinField("Ymax", ymax, lblYmax, txtYmax) picGraph = New GraphCanvas() picGraph.BackColor = Color.FromArgb(10, 10, 16) picGraph.BorderStyle = BorderStyle.FixedSingle picGraph.TabStop = True AddHandler picGraph.Paint, AddressOf PicGraph_Paint AddHandler picGraph.WindowChanged, AddressOf PicGraph_WindowChanged AddHandler picGraph.TraceRequested, AddressOf PicGraph_TraceRequested pnlGraph.Controls.Add(picGraph) pnlGraphKeys = New Panel() pnlGraphKeys.BackColor = Color.Black pnlGraph.Controls.Add(pnlGraphKeys) lblTrace = modUtilities.MakeUtilityLabel(pnlGraph, 0, 0, 200, 22, 12.0F) lblTrace.Text = "TRACE — tap · drag pan · pinch/wheel zoom" fbTraceLeft = ApplyNamed(modUtilities.MakeUtilityButton(pnlGraph, "←", 0, 0, 40, 24, LCARS.LCARScolorStyles.PrimaryFunction, Sub(s As Object, e As EventArgs) NudgeTrace(-1)), "←") fbTraceRight = ApplyNamed(modUtilities.MakeUtilityButton(pnlGraph, "→", 0, 0, 40, 24, LCARS.LCARScolorStyles.PrimaryFunction, Sub(s As Object, e As EventArgs) NudgeTrace(1)), "→") fbTable = ApplyNamed(modUtilities.MakeUtilityButton(pnlGraph, "TABLE", 0, 0, 70, 24, LCARS.LCARScolorStyles.MiscFunction, Sub(s As Object, e As EventArgs) ShowTable()), "TABLE") End Sub Private Function ApplyNamed(ByVal btn As LCARS.Controls.FlatButton, ByVal caption As String) As LCARS.Controls.FlatButton ApplyKeyFont(btn, caption) Return btn End Function Private Sub AddWinField(ByVal caption As String, ByVal value As Double, ByRef lbl As Label, ByRef box As TextBox) lbl = modUtilities.MakeUtilityLabel(pnlGraph, 0, 0, 44, 22, 11.0F) lbl.Text = caption box = New TextBox() box.BackColor = Color.FromArgb(20, 20, 20) box.ForeColor = Color.Orange box.BorderStyle = BorderStyle.FixedSingle box.Font = New Font(KeyFontName, 12.0!, FontStyle.Bold) box.Text = value.ToString(CultureInfo.InvariantCulture) pnlGraph.Controls.Add(box) End Sub Private Sub LayoutChrome() If layoutBusy OrElse Not IsHandleCreated Then Return layoutBusy = True Try Dim m As Integer = modUtilities.UtilityMargin Dim w As Integer = Math.Max(320, ClientSize.Width - m * 2) Dim h As Integer = Math.Max(240, ClientSize.Height) If titleBar IsNot Nothing Then titleBar.Location = New Point(m, m) titleBar.Size = New Size(w, modUtilities.UtilityButtonHeight) End If fbModeBasic.Location = New Point(m, 40) fbModeSci.Location = New Point(m + 96, 40) fbModeGraph.Location = New Point(m + 192, 40) fbDegRad.Location = New Point(m + 300, 40) Dim bodyTop As Integer If currentMode = CalcUiMode.Graph Then lblDisplay.Visible = False lblStatus.Visible = False bodyTop = 72 Else lblDisplay.Visible = True lblStatus.Visible = True lblDisplay.SetBounds(m, 70, w, 48) lblStatus.SetBounds(m, 120, w, 18) bodyTop = 142 End If fbClose.SetBounds(m, h - m - CloseButtonHeight, w, CloseButtonHeight) Dim bodyBottom As Integer = fbClose.Top - 6 Dim bodyH As Integer = Math.Max(100, bodyBottom - bodyTop) pnlKeys.SetBounds(m, bodyTop, w, bodyH) pnlGraph.SetBounds(m, bodyTop, w, bodyH) If currentMode = CalcUiMode.Graph Then LayoutGraphBody() ElseIf pnlKeys.Visible Then RebuildKeys() End If Finally layoutBusy = False End Try End Sub Private Sub LayoutGraphBody() Dim y As Integer = 0 Dim w As Integer = pnlGraph.ClientSize.Width Dim h As Integer = pnlGraph.ClientSize.Height lblY1.SetBounds(0, y + 2, 40, 24) Dim btnClusterW As Integer = 80 + 8 + 70 + 8 + 70 txtY1.SetBounds(44, y, Math.Max(120, w - 44 - btnClusterW - 12), 26) Dim bx As Integer = txtY1.Right + 8 fbPlot.SetBounds(bx, y, 80, 26) fbZstd.SetBounds(bx + 88, y, 70, 26) fbZfit.SetBounds(bx + 166, y, 70, 26) y += 30 PlaceWinField(lblXmin, txtXmin, 0, y) PlaceWinField(lblXmax, txtXmax, 180, y) PlaceWinField(lblYmin, txtYmin, 360, y) PlaceWinField(lblYmax, txtYmax, 540, y) y += 28 Dim traceH As Integer = 26 Dim plotH As Integer = h - y - traceH - 2 If plotH < 80 Then plotH = 80 Dim keyW As Integer = GraphKeypadWidth If w < keyW + 200 Then keyW = Math.Max(180, w \ 3) Dim plotW As Integer = w - keyW - 8 If plotW < 120 Then keyW = Math.Max(140, w \ 3) plotW = Math.Max(100, w - keyW - 8) End If picGraph.SetBounds(0, y, plotW, plotH) pnlGraphKeys.SetBounds(plotW + 8, y, keyW, plotH) y += plotH + 2 lblTrace.SetBounds(0, y, Math.Max(80, plotW - 180), 22) fbTraceLeft.SetBounds(plotW - 170, y - 2, 40, 24) fbTraceRight.SetBounds(plotW - 124, y - 2, 40, 24) fbTable.SetBounds(plotW - 78, y - 2, 70, 24) RebuildGraphKeys() picGraph.SetWindow(xmin, xmax, ymin, ymax) If y1Expr <> "" Then PlotGraph() Else picGraph.Invalidate() End Sub Private Shared Sub PlaceWinField(ByVal lbl As Label, ByVal box As TextBox, ByVal x As Integer, ByVal y As Integer) lbl.SetBounds(x, y, 44, 22) box.SetBounds(x + 46, y, 80, 22) End Sub Private Sub ShowMode(ByVal mode As CalcUiMode) currentMode = mode fbModeBasic.Color = If(mode = CalcUiMode.Basic, LCARS.LCARScolorStyles.Orange, LCARS.LCARScolorStyles.PrimaryFunction) fbModeSci.Color = If(mode = CalcUiMode.Sci, LCARS.LCARScolorStyles.Orange, LCARS.LCARScolorStyles.PrimaryFunction) fbModeGraph.Color = If(mode = CalcUiMode.Graph, LCARS.LCARScolorStyles.Orange, LCARS.LCARScolorStyles.PrimaryFunction) fbModeBasic.Invalidate() fbModeSci.Invalidate() fbModeGraph.Invalidate() Dim graph As Boolean = (mode = CalcUiMode.Graph) pnlGraph.Visible = graph pnlKeys.Visible = Not graph LayoutChrome() If graph Then SyncWindowBoxes() picGraph.SetWindow(xmin, xmax, ymin, ymax) picGraph.Invalidate() Else RebuildKeys() RefreshDisplay() End If End Sub Private Sub ToggleAngleMode(ByVal sender As Object, ByVal e As EventArgs) If angleMode = CalcEngine.AngleMode.Degrees Then angleMode = CalcEngine.AngleMode.Radians fbDegRad.ButtonText = "RAD" Else angleMode = CalcEngine.AngleMode.Degrees fbDegRad.ButtonText = "DEG" End If fbDegRad.Text = fbDegRad.ButtonText UpdateStatus() End Sub Private Sub RebuildKeys() FillKeyPanel(pnlKeys, If(currentMode = CalcUiMode.Basic, BasicRows(), SciRows()), AddressOf HandlePad) End Sub Private Sub RebuildGraphKeys() FillKeyPanel(pnlGraphKeys, GraphRows(), AddressOf HandleGraphPad) End Sub Private Sub FillKeyPanel(ByVal host As Panel, ByVal rows As List(Of String()), ByVal handler As Action(Of String)) host.Controls.Clear() If host.Width < 10 OrElse host.Height < 10 Then Return Dim cols As Integer = 0 For Each r As String() In rows If r.Length > cols Then cols = r.Length Next Dim gap As Integer = 3 Dim kw As Integer = Math.Max(20, (host.Width - gap * (cols - 1)) \ cols) Dim kh As Integer = Math.Max(18, (host.Height - gap * (rows.Count - 1)) \ rows.Count) For row As Integer = 0 To rows.Count - 1 Dim keys() As String = rows(row) For col As Integer = 0 To keys.Length - 1 Dim caption As String = keys(col) If caption = "" Then Continue For Dim x As Integer = col * (kw + gap) Dim y As Integer = row * (kh + gap) Dim press As String = caption Dim color As LCARS.LCARScolorStyles = KeyColor(caption) Dim btn As LCARS.Controls.FlatButton = modUtilities.MakeUtilityButton(host, caption, x, y, kw, kh, color, Sub(s As Object, e As EventArgs) handler(press)) ApplyKeyFont(btn, caption) Next Next End Sub Private Shared Sub ApplyKeyFont(ByVal btn As LCARS.Controls.FlatButton, ByVal caption As String) If btn Is Nothing Then Return Dim size As Single = If(IsOperatorKey(caption), KeyFontOperator, KeyFontNormal) Dim style As FontStyle = If(IsOperatorKey(caption), FontStyle.Bold, FontStyle.Regular) Try btn.ButtonTextHeight = CInt(size) btn.Font = New Font(KeyFontName, size, style, GraphicsUnit.Point) Catch End Try btn.Invalidate() End Sub Private Shared Function IsOperatorKey(ByVal key As String) As Boolean Select Case key Case "+", "-", "*", "/", "^", "=", "(", ")", "." Return True Case Else Return False End Select End Function Private Shared Function BasicRows() As List(Of String()) Return New List(Of String()) From { New String() {"C", "BKSP", "(", ")", "/"}, New String() {"7", "8", "9", "*", "^"}, New String() {"4", "5", "6", "-", "ANS"}, New String() {"1", "2", "3", "+", "π"}, New String() {"0", ".", "+/-", "=", "e"} } End Function Private Shared Function SciRows() As List(Of String()) Return New List(Of String()) From { New String() {"C", "BKSP", "(", ")", "/", "^"}, New String() {"sin", "cos", "tan", "asin", "acos", "atan"}, New String() {"ln", "log10", "exp", "√", "x²", "1/x"}, New String() {"sinh", "cosh", "tanh", "nPr", "nCr", "x!"}, New String() {"7", "8", "9", "*", "π", "e"}, New String() {"4", "5", "6", "-", "ANS", "abs"}, New String() {"1", "2", "3", "+", "M+", "MR"}, New String() {"0", ".", "+/-", "=", "MC", "x"} } End Function Private Shared Function GraphRows() As List(Of String()) Return New List(Of String()) From { New String() {"C", "BKSP", "(", ")", "/"}, New String() {"7", "8", "9", "*", "^"}, New String() {"4", "5", "6", "-", "x"}, New String() {"1", "2", "3", "+", "x²"}, New String() {"0", ".", "π", "e", "PLOT"} } End Function Private Shared Function KeyColor(ByVal key As String) As LCARS.LCARScolorStyles Select Case key Case "C", "BKSP", "MC" : Return LCARS.LCARScolorStyles.FunctionOffline Case "+", "-", "*", "/", "^", "=", "PLOT" : Return LCARS.LCARScolorStyles.PrimaryFunction Case "sin", "cos", "tan", "asin", "acos", "atan", "ln", "log10", "exp", "√", "x²", "1/x", "sinh", "cosh", "tanh", "nPr", "nCr", "x!", "abs", "x" Return LCARS.LCARScolorStyles.MiscFunction Case Else : Return LCARS.LCARScolorStyles.Orange End Select End Function Private Sub HandlePad(ByVal key As String) Select Case key Case "C" expr = "" RefreshDisplay() Case "BKSP" If expr.Length > 0 Then expr = expr.Substring(0, expr.Length - 1) RefreshDisplay() Case "=" EvaluateExpr() Case "+/-" If expr.StartsWith("-", StringComparison.Ordinal) Then expr = expr.Substring(1) ElseIf expr.Length > 0 Then expr = "-" & expr End If RefreshDisplay() Case "ANS" InsertText(CalcEngine.FormatNumber(ans)) Case "π" InsertText("pi") Case "e" InsertText("e") Case "x" InsertText("x") Case "√" InsertFn("sqrt") Case "x²" InsertText("^2") Case "1/x" expr = "1/(" & If(expr = "", "0", expr) & ")" RefreshDisplay() Case "x!" InsertFn("fact") Case "nPr" InsertFn("nPr") Case "nCr" InsertFn("nCr") Case "abs" InsertFn("abs") Case "sin", "cos", "tan", "asin", "acos", "atan", "sinh", "cosh", "tanh", "ln", "log10", "exp" InsertFn(key) Case "M+" EvaluateExpr(False) memory += ans UpdateStatus() Case "MR" InsertText(CalcEngine.FormatNumber(memory)) Case "MC" memory = 0 UpdateStatus() Case Else InsertText(key) End Select End Sub Private Sub HandleGraphPad(ByVal key As String) Select Case key Case "C" txtY1.Text = "" txtY1.Focus() txtY1.SelectionStart = 0 Case "BKSP" Dim t As String = txtY1.Text Dim caret As Integer = txtY1.SelectionStart If txtY1.SelectionLength > 0 Then txtY1.Text = t.Remove(txtY1.SelectionStart, txtY1.SelectionLength) txtY1.SelectionStart = caret ElseIf caret > 0 AndAlso t.Length > 0 Then txtY1.Text = t.Remove(caret - 1, 1) txtY1.SelectionStart = caret - 1 End If txtY1.Focus() Case "PLOT", "=" PlotGraph() Case "π" InsertIntoY1("pi") Case "e" InsertIntoY1("e") Case "x" InsertIntoY1("x") Case "x²" InsertIntoY1("^2") Case Else InsertIntoY1(key) End Select End Sub Private Sub InsertIntoY1(ByVal text As String) Dim t As String = If(txtY1.Text, "") Dim start As Integer = txtY1.SelectionStart Dim len As Integer = txtY1.SelectionLength If start < 0 Then start = t.Length If len < 0 Then len = 0 If start + len > t.Length Then len = Math.Max(0, t.Length - start) txtY1.Text = t.Substring(0, start) & text & t.Substring(start + len) txtY1.SelectionStart = start + text.Length txtY1.SelectionLength = 0 txtY1.Focus() End Sub Private Sub InsertFn(ByVal name As String) InsertText(name & "(") End Sub Private Sub InsertText(ByVal text As String) expr &= text RefreshDisplay() End Sub Private Sub EvaluateExpr(Optional ByVal updateDisplay As Boolean = True) Dim source As String = If(expr = "", CalcEngine.FormatNumber(ans), expr) Dim r As CalcEngine.EvalResult = CalcEngine.Evaluate(source, angleMode) If Not r.Ok Then If updateDisplay Then lblDisplay.Text = "ERROR" lblStatus.Text = "ERR: " & r.ErrorMessage.ToUpperInvariant() Return End If ans = r.Value expr = "" If updateDisplay Then lblDisplay.Text = CalcEngine.FormatNumber(ans) UpdateStatus() End If End Sub Private Sub RefreshDisplay() If expr = "" Then lblDisplay.Text = CalcEngine.FormatNumber(ans) Else lblDisplay.Text = expr End If UpdateStatus() End Sub Private Sub UpdateStatus() Dim ang As String = If(angleMode = CalcEngine.AngleMode.Degrees, "DEG", "RAD") lblStatus.Text = ang & " · ANS=" & CalcEngine.FormatNumber(ans) & " · M=" & CalcEngine.FormatNumber(memory) End Sub Private Sub OnFormKeyDown(ByVal sender As Object, ByVal e As KeyEventArgs) If currentMode = CalcUiMode.Graph Then If e.KeyCode = Keys.Enter OrElse e.KeyCode = Keys.Return Then PlotGraph() e.Handled = True End If Return End If If e.KeyCode = Keys.Enter OrElse e.KeyCode = Keys.Return Then EvaluateExpr() e.Handled = True Return End If If e.KeyCode = Keys.Escape Then expr = "" RefreshDisplay() e.Handled = True Return End If If e.KeyCode = Keys.Back Then HandlePad("BKSP") e.Handled = True End If End Sub Private Sub OnFormKeyPress(ByVal sender As Object, ByVal e As KeyPressEventArgs) If currentMode = CalcUiMode.Graph Then Return Dim ch As Char = e.KeyChar If Char.IsDigit(ch) OrElse ch = "."c OrElse "+-*/^()".IndexOf(ch) >= 0 Then InsertText(ch.ToString()) e.Handled = True ElseIf ch = "="c OrElse ch = ChrW(13) Then EvaluateExpr() e.Handled = True End If End Sub ' ---- Graphing ---- Private Sub ReadWindow() Double.TryParse(txtXmin.Text, NumberStyles.Float, CultureInfo.InvariantCulture, xmin) Double.TryParse(txtXmax.Text, NumberStyles.Float, CultureInfo.InvariantCulture, xmax) Double.TryParse(txtYmin.Text, NumberStyles.Float, CultureInfo.InvariantCulture, ymin) Double.TryParse(txtYmax.Text, NumberStyles.Float, CultureInfo.InvariantCulture, ymax) If xmax <= xmin Then xmax = xmin + 1 If ymax <= ymin Then ymax = ymin + 1 y1Expr = If(txtY1.Text, "").Trim() picGraph.SetWindow(xmin, xmax, ymin, ymax) End Sub Private Sub ZoomStandard() xmin = -10 : xmax = 10 : ymin = -10 : ymax = 10 SyncWindowBoxes() picGraph.SetWindow(xmin, xmax, ymin, ymax) PlotGraph() End Sub Private Sub ZoomFit() ReadWindow() If y1Expr = "" Then Return Dim ys As New List(Of Double)() Dim steps As Integer = 200 For i As Integer = 0 To steps Dim xv As Double = xmin + (xmax - xmin) * i / steps Dim r As CalcEngine.EvalResult = CalcEngine.Evaluate(y1Expr, angleMode, xv) If r.Ok AndAlso Not Double.IsNaN(r.Value) AndAlso Not Double.IsInfinity(r.Value) Then ys.Add(r.Value) End If Next If ys.Count = 0 Then Return ymin = ys(0) : ymax = ys(0) For Each v As Double In ys If v < ymin Then ymin = v If v > ymax Then ymax = v Next Dim pad As Double = (ymax - ymin) * 0.1 If pad < 0.0001 Then pad = 1 ymin -= pad ymax += pad SyncWindowBoxes() picGraph.SetWindow(xmin, xmax, ymin, ymax) PlotGraph() End Sub Private Sub SyncWindowBoxes() txtXmin.Text = xmin.ToString(CultureInfo.InvariantCulture) txtXmax.Text = xmax.ToString(CultureInfo.InvariantCulture) txtYmin.Text = ymin.ToString(CultureInfo.InvariantCulture) txtYmax.Text = ymax.ToString(CultureInfo.InvariantCulture) txtY1.Text = y1Expr End Sub Private Sub PicGraph_WindowChanged(ByVal sender As Object, ByVal e As EventArgs) picGraph.GetWindow(xmin, xmax, ymin, ymax) SyncWindowBoxes() RecomputeCurve() UpdateTraceLabel() picGraph.Invalidate() End Sub Private Sub PicGraph_TraceRequested(ByVal sender As Object, ByVal location As Point) traceX = picGraph.UnmapX(location.X) UpdateTraceLabel() picGraph.Invalidate() End Sub Private Sub PlotGraph() ReadWindow() SyncWindowBoxes() RecomputeCurve() If graphOk OrElse y1Expr = "" Then traceX = (xmin + xmax) / 2 End If UpdateTraceLabel() picGraph.Invalidate() End Sub Private Sub RecomputeCurve() graphPoints.Clear() graphOk = False If y1Expr = "" Then Return Dim w As Integer = Math.Max(10, picGraph.ClientSize.Width) Dim samples As Integer = Math.Max(80, w) Dim lastOk As Boolean = False For i As Integer = 0 To samples Dim xv As Double = xmin + (xmax - xmin) * i / samples Dim r As CalcEngine.EvalResult = CalcEngine.Evaluate(y1Expr, angleMode, xv) If r.Ok AndAlso Not Double.IsNaN(r.Value) AndAlso Not Double.IsInfinity(r.Value) Then graphPoints.Add(New PointF(CSng(xv), CSng(r.Value))) lastOk = True graphOk = True ElseIf lastOk Then graphPoints.Add(New PointF(Single.NaN, Single.NaN)) lastOk = False End If Next End Sub Private Sub PicGraph_Paint(ByVal sender As Object, ByVal e As PaintEventArgs) Dim g As Graphics = e.Graphics g.SmoothingMode = SmoothingMode.AntiAlias g.Clear(Color.FromArgb(10, 10, 16)) Dim w As Integer = picGraph.ClientSize.Width Dim h As Integer = picGraph.ClientSize.Height If w < 2 OrElse h < 2 Then Return Using penGrid As New Pen(Color.FromArgb(40, 60, 80), 1) Dim x0 As Integer = MapX(0) Dim y0 As Integer = MapY(0) If x0 >= 0 AndAlso x0 < w Then g.DrawLine(penGrid, x0, 0, x0, h) If y0 >= 0 AndAlso y0 < h Then g.DrawLine(penGrid, 0, y0, w, y0) End Using If graphOk AndAlso graphPoints.Count > 1 Then Using pen As New Pen(Color.Orange, 2) Dim prev As PointF = New PointF(Single.NaN, Single.NaN) For Each p As PointF In graphPoints If Single.IsNaN(p.X) OrElse Single.IsNaN(p.Y) OrElse Single.IsInfinity(p.X) OrElse Single.IsInfinity(p.Y) Then prev = New PointF(Single.NaN, Single.NaN) Continue For End If Dim sx As Integer = MapX(p.X) Dim sy As Integer = MapY(p.Y) If Not Single.IsNaN(prev.X) AndAlso Not Single.IsInfinity(prev.X) Then Dim px As Integer = MapX(prev.X) Dim py As Integer = MapY(prev.Y) If Math.Abs(sy - py) < h * 2 Then g.DrawLine(pen, px, py, sx, sy) End If End If prev = p Next End Using End If Dim tx As Integer = MapX(traceX) Dim tyVal As Double = TraceY() Using penT As New Pen(Color.FromArgb(153, 204, 255), 1) g.DrawLine(penT, tx, 0, tx, h) If IsFinite(tyVal) Then Dim ty As Integer = MapY(tyVal) g.DrawEllipse(penT, tx - 4, ty - 4, 8, 8) End If End Using End Sub Private Function MapX(ByVal x As Double) As Integer Dim w As Integer = picGraph.ClientSize.Width If w < 2 OrElse Not IsFinite(x) OrElse Not IsFinite(xmin) OrElse Not IsFinite(xmax) OrElse xmax = xmin Then Return 0 End If Return ClampToInt((x - xmin) / (xmax - xmin) * (w - 1)) End Function Private Function MapY(ByVal y As Double) As Integer Dim h As Integer = picGraph.ClientSize.Height If h < 2 OrElse Not IsFinite(y) OrElse Not IsFinite(ymin) OrElse Not IsFinite(ymax) OrElse ymax = ymin Then Return 0 End If Return ClampToInt((ymax - y) / (ymax - ymin) * (h - 1)) End Function Private Shared Function IsFinite(ByVal v As Double) As Boolean Return Not Double.IsNaN(v) AndAlso Not Double.IsInfinity(v) End Function Private Shared Function ClampToInt(ByVal v As Double) As Integer If Double.IsNaN(v) OrElse Double.IsInfinity(v) Then Return 0 If v >= Integer.MaxValue Then Return Integer.MaxValue If v <= Integer.MinValue Then Return Integer.MinValue Return CInt(Math.Round(v)) End Function Private Function TraceY() As Double Dim r As CalcEngine.EvalResult = CalcEngine.Evaluate(y1Expr, angleMode, traceX) If r.Ok Then Return r.Value Return Double.NaN End Function Private Sub UpdateTraceLabel() Dim yv As Double = TraceY() If Double.IsNaN(yv) Then lblTrace.Text = "TRACE X=" & CalcEngine.FormatNumber(traceX) & " Y=— · pan/pinch/wheel" Else lblTrace.Text = "TRACE X=" & CalcEngine.FormatNumber(traceX) & " Y=" & CalcEngine.FormatNumber(yv) End If End Sub Private Sub NudgeTrace(ByVal dir As Integer) Dim stepX As Double = (xmax - xmin) / Math.Max(40, picGraph.ClientSize.Width) traceX += dir * stepX If traceX < xmin Then traceX = xmin If traceX > xmax Then traceX = xmax UpdateTraceLabel() picGraph.Invalidate() End Sub Private Sub ShowTable() ReadWindow() Dim sb As New System.Text.StringBuilder() sb.AppendLine("X" & vbTab & "Y1=" & y1Expr) Dim n As Integer = 13 For i As Integer = 0 To n - 1 Dim xv As Double = xmin + (xmax - xmin) * i / (n - 1) Dim r As CalcEngine.EvalResult = CalcEngine.Evaluate(y1Expr, angleMode, xv) Dim yv As String = If(r.Ok, CalcEngine.FormatNumber(r.Value), "ERR") sb.AppendLine(CalcEngine.FormatNumber(xv) & vbTab & yv) Next MessageBox.Show(sb.ToString(), "TABLE", MessageBoxButtons.OK, MessageBoxIcon.Information) End Sub
End Class
