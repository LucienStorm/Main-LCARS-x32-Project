' LCARSutilities/LCARSutilities/Forms/frmWeather.vb
Option Strict On
Option Explicit On Imports System.Drawing
Imports System.Globalization
Imports System.Threading
Imports System.Windows.Forms
Imports LCARS.Controls ''' <summary>Detailed Open-Meteo forecast (same location settings as the shell weather HUD).</summary>
Public Class frmWeather Inherits LCARS.LCARSForm ' Tall enough for current + hourly strip + 7-day cards without vertical OS scrollbars. Private Const FormWidth As Integer = 800 Private Const FormHeight As Integer = 640 Private Const HourStripHeight As Integer = 118 Private Const DayStripHeight As Integer = 168 Private Const HourCardWidth As Integer = 78 Private Const DayCardWidth As Integer = 150 Private Const CardGap As Integer = 6 Private lblPlace As Label Private lblCurrent As Label Private lblCondition As Label Private lblDetails As Label Private lblStatus As Label Private lblHourlyHeader As Label Private lblDailyHeader As Label Private scrollHours As LcarsHScrollPanel Private scrollDays As LcarsHScrollPanel Private loadBusy As Boolean = False Private lastSnap As WeatherClient.ForecastSnapshot = Nothing Public Sub New() MyBase.New() modUtilities.InitUtilityFormFloating(Me, FormWidth, FormHeight) BuildUi() AddHandler Me.Shown, Sub(s As Object, e As EventArgs) BeginRefresh() AddHandler Me.Resize, Sub(s As Object, e As EventArgs) LayoutUi() End Sub Private Sub BuildUi() Dim m As Integer = modUtilities.UtilityMargin Dim contentW As Integer = FormWidth - m * 2 modUtilities.MakeUtilityTitle(Me, "WEATHER", contentW - 360) modUtilities.MakeUtilityButton(Me, "REFRESH", FormWidth - m - 350, m, 110, 28, LCARS.LCARScolorStyles.PrimaryFunction, Sub(s As Object, e As EventArgs) BeginRefresh()) modUtilities.MakeUtilityButton(Me, "MAP", FormWidth - m - 230, m, 100, 28, LCARS.LCARScolorStyles.NavigationFunction, Sub(s As Object, e As EventArgs) OpenMap()) modUtilities.MakeUtilityButton(Me, "CLOSE", FormWidth - m - 120, m, 110, 28, LCARS.LCARScolorStyles.FunctionOffline, Sub(s As Object, e As EventArgs) Close()) lblPlace = modUtilities.MakeUtilityLabel(Me, m, 48, contentW, 24, 16.0F) lblPlace.Text = "LOCATING…" lblCurrent = modUtilities.MakeUtilityLabel(Me, m, 74, 220, 48, 36.0F) lblCurrent.Text = "—" lblCondition = modUtilities.MakeUtilityLabel(Me, m + 230, 78, contentW - 230, 40, 14.0F) lblCondition.Text = "" lblDetails = modUtilities.MakeUtilityLabel(Me, m, 128, contentW, 22, 12.0F) lblDetails.Text = "" lblStatus = modUtilities.MakeUtilityLabel(Me, m, 152, contentW, 18, 11.0F) lblStatus.Text = "" lblHourlyHeader = modUtilities.MakeUtilityLabel(Me, m, 178, contentW, 18, 11.0F) lblHourlyHeader.Text = "HOURLY — SWIPE" scrollHours = New LcarsHScrollPanel() Controls.Add(scrollHours) lblDailyHeader = modUtilities.MakeUtilityLabel(Me, m, 178 + 22 + HourStripHeight + 8, contentW, 18, 11.0F) lblDailyHeader.Text = "7-DAY — SWIPE" scrollDays = New LcarsHScrollPanel() Controls.Add(scrollDays) LayoutUi() End Sub Private Sub LayoutUi() Dim m As Integer = modUtilities.UtilityMargin Dim w As Integer = Math.Max(320, ClientSize.Width - m * 2) lblPlace.Width = w lblCondition.Width = Math.Max(120, w - 230) lblDetails.Width = w lblStatus.Width = w lblHourlyHeader.Width = w lblDailyHeader.Width = w Dim hoursTop As Integer = 198 scrollHours.SetBounds(m, hoursTop, w, HourStripHeight) Dim daysTop As Integer = hoursTop + HourStripHeight + 28 lblDailyHeader.Top = daysTop - 20 Dim daysH As Integer = Math.Max(DayStripHeight, ClientSize.Height - daysTop - m) ' Cap day strip so we don't invite vertical OS scroll elsewhere. If daysH > DayStripHeight + 40 Then daysH = DayStripHeight + 40 scrollDays.SetBounds(m, daysTop, w, daysH) RelayoutHourCards() RelayoutDayCards() End Sub Private Sub BeginRefresh() If loadBusy Then Return loadBusy = True lblStatus.Text = "LOADING…" ThreadPool.QueueUserWorkItem(AddressOf RefreshWorker) End Sub Private Sub RefreshWorker(ByVal state As Object) Dim snap As WeatherClient.ForecastSnapshot = Nothing Try snap = WeatherClient.FetchForecast(7) Catch ex As Exception snap = New WeatherClient.ForecastSnapshot() snap.ErrorMessage = ex.Message End Try If IsDisposed Then Return Dim captured As WeatherClient.ForecastSnapshot = snap BeginInvoke(New MethodInvoker(Sub() ApplySnapshot(captured))) End Sub Private Sub ApplySnapshot(ByVal snap As WeatherClient.ForecastSnapshot) loadBusy = False lastSnap = snap If snap Is Nothing Then lblStatus.Text = "ERROR" Return End If If Not snap.Ok Then lblPlace.Text = "WEATHER" lblCurrent.Text = "—" lblCondition.Text = "" lblDetails.Text = "" lblStatus.Text = snap.ErrorMessage.ToUpperInvariant() scrollHours.ContentPanel.Controls.Clear() scrollDays.ContentPanel.Controls.Clear() scrollHours.Relayout() scrollDays.Relayout() Return End If Dim place As String = snap.PlaceLabel If place = "" Then place = String.Format(CultureInfo.InvariantCulture, "{0:0.####}, {1:0.####}", snap.Latitude, snap.Longitude) End If lblPlace.Text = place.ToUpperInvariant() If snap.CurrentTemp.HasValue Then lblCurrent.Text = CInt(Math.Round(snap.CurrentTemp.Value)).ToString(CultureInfo.InvariantCulture) & "°" & snap.UnitSymbol Else lblCurrent.Text = "—" End If Dim cond As String = snap.CurrentCondition If snap.FeelsLike.HasValue Then cond &= " · FEELS " & CInt(Math.Round(snap.FeelsLike.Value)).ToString(CultureInfo.InvariantCulture) & "°" & snap.UnitSymbol End If lblCondition.Text = cond Dim bits As New System.Collections.Generic.List(Of String)() If snap.Humidity.HasValue Then bits.Add("HUM " & CInt(Math.Round(snap.Humidity.Value)).ToString(CultureInfo.InvariantCulture) & "%") If snap.WindSpeed.HasValue Then bits.Add("WIND " & CInt(Math.Round(snap.WindSpeed.Value)).ToString(CultureInfo.InvariantCulture)) If snap.PrecipCurrent.HasValue Then bits.Add("PRECIP " & snap.PrecipCurrent.Value.ToString("0.#", CultureInfo.InvariantCulture)) lblDetails.Text = String.Join(" · ", bits.ToArray()) lblStatus.Text = "OPEN-METEO · " & DateTime.Now.ToString("HH:mm", CultureInfo.InvariantCulture) BuildHourCards(snap) BuildDayCards(snap) End Sub Private Sub OpenMap() Dim lat As Double = 0 Dim lon As Double = 0 If lastSnap IsNot Nothing AndAlso lastSnap.Ok Then lat = lastSnap.Latitude lon = lastSnap.Longitude Else Dim fix As WeatherClient.LocationFix = WeatherClient.ResolveLocation() If Not fix.Ok Then lblStatus.Text = fix.ErrorMessage.ToUpperInvariant() Return End If lat = fix.Latitude lon = fix.Longitude End If modUtilities.OpenUrlInLcarsBrowser(WeatherClient.OpenStreetMapUrl(lat, lon, 12)) lblStatus.Text = "MAP OPENED IN BROWSER." End Sub Private Sub BuildHourCards(ByVal snap As WeatherClient.ForecastSnapshot) scrollHours.ContentPanel.Controls.Clear() Dim unit As String = snap.UnitSymbol Dim cardH As Integer = Math.Max(70, HourStripHeight - 28 - 4) For Each hour As WeatherClient.HourForecast In snap.Hours Dim card As New Panel() card.BackColor = Color.FromArgb(16, 16, 16) card.BorderStyle = BorderStyle.FixedSingle card.Size = New Size(HourCardWidth, cardH) Dim tLbl As New Label() tLbl.ForeColor = Color.Orange tLbl.BackColor = Color.Transparent tLbl.Font = New Font(modUtilities.UtilityFontName, 10.0F, FontStyle.Bold) tLbl.Text = hour.TimeLabel tLbl.SetBounds(4, 4, HourCardWidth - 8, 16) card.Controls.Add(tLbl) Dim tempLbl As New Label() tempLbl.ForeColor = Color.FromArgb(255, 204, 102) tempLbl.BackColor = Color.Transparent tempLbl.Font = New Font(modUtilities.UtilityFontName, 14.0F, FontStyle.Bold) tempLbl.Text = If(hour.Temp.HasValue, CInt(Math.Round(hour.Temp.Value)).ToString(CultureInfo.InvariantCulture) & "°" & unit, "—") tempLbl.SetBounds(4, 24, HourCardWidth - 8, 22) card.Controls.Add(tempLbl) Dim cLbl As New Label() cLbl.ForeColor = Color.Orange cLbl.BackColor = Color.Transparent cLbl.Font = New Font(modUtilities.UtilityFontName, 8.0F, FontStyle.Regular) Dim line As String = hour.Condition If hour.PrecipProbability.HasValue Then line &= " " & CInt(Math.Round(hour.PrecipProbability.Value)).ToString(CultureInfo.InvariantCulture) & "%" End If cLbl.Text = line cLbl.SetBounds(4, 50, HourCardWidth - 8, Math.Max(20, cardH - 54)) card.Controls.Add(cLbl) scrollHours.ContentPanel.Controls.Add(card) Next RelayoutHourCards() scrollHours.HookScrollGesture(scrollHours.ContentPanel) End Sub Private Sub BuildDayCards(ByVal snap As WeatherClient.ForecastSnapshot) scrollDays.ContentPanel.Controls.Clear() Dim unit As String = snap.UnitSymbol Dim cardH As Integer = Math.Max(110, DayStripHeight - 28 - 4) For Each day As WeatherClient.DayForecast In snap.Days Dim card As New Panel() card.BackColor = Color.FromArgb(16, 16, 16) card.BorderStyle = BorderStyle.FixedSingle card.Size = New Size(DayCardWidth, cardH) Dim dLbl As New Label() dLbl.ForeColor = Color.Orange dLbl.BackColor = Color.Transparent dLbl.Font = New Font(modUtilities.UtilityFontName, 11.0F, FontStyle.Bold) dLbl.Text = day.DateLabel dLbl.SetBounds(8, 6, DayCardWidth - 16, 20) card.Controls.Add(dLbl) Dim cLbl As New Label() cLbl.ForeColor = Color.FromArgb(255, 204, 102) cLbl.BackColor = Color.Transparent cLbl.Font = New Font(modUtilities.UtilityFontName, 10.0F, FontStyle.Regular) cLbl.Text = day.Condition cLbl.SetBounds(8, 28, DayCardWidth - 16, 28) card.Controls.Add(cLbl) Dim tLbl As New Label() tLbl.ForeColor = Color.Orange tLbl.BackColor = Color.Transparent tLbl.Font = New Font(modUtilities.UtilityFontName, 14.0F, FontStyle.Bold) Dim hi As String = If(day.High.HasValue, CInt(Math.Round(day.High.Value)).ToString(CultureInfo.InvariantCulture), "—") Dim lo As String = If(day.Low.HasValue, CInt(Math.Round(day.Low.Value)).ToString(CultureInfo.InvariantCulture), "—") tLbl.Text = hi & "° / " & lo & "°" & unit tLbl.SetBounds(8, 60, DayCardWidth - 16, 24) card.Controls.Add(tLbl) Dim xtra As New Label() xtra.ForeColor = Color.FromArgb(200, 160, 80) xtra.BackColor = Color.Transparent xtra.Font = New Font(modUtilities.UtilityFontName, 9.0F, FontStyle.Regular) Dim bits As New System.Collections.Generic.List(Of String)() If day.PrecipSum.HasValue Then bits.Add("P " & day.PrecipSum.Value.ToString("0.#", CultureInfo.InvariantCulture)) If day.WindMax.HasValue Then bits.Add("W " & CInt(Math.Round(day.WindMax.Value)).ToString(CultureInfo.InvariantCulture)) xtra.Text = String.Join(" · ", bits.ToArray()) xtra.SetBounds(8, 88, DayCardWidth - 16, 18) card.Controls.Add(xtra) scrollDays.ContentPanel.Controls.Add(card) Next RelayoutDayCards() scrollDays.HookScrollGesture(scrollDays.ContentPanel) End Sub Private Sub RelayoutHourCards() If scrollHours Is Nothing Then Return Dim x As Integer = 0 Dim cardH As Integer = Math.Max(70, scrollHours.Height - 28 - 4) For Each c As Control In scrollHours.ContentPanel.Controls If TypeOf c Is Panel Then c.SetBounds(x, 0, HourCardWidth, cardH) x += HourCardWidth + CardGap End If Next scrollHours.Relayout() End Sub Private Sub RelayoutDayCards() If scrollDays Is Nothing Then Return Dim x As Integer = 0 Dim cardH As Integer = Math.Max(110, scrollDays.Height - 28 - 4) For Each c As Control In scrollDays.ContentPanel.Controls If TypeOf c Is Panel Then c.SetBounds(x, 0, DayCardWidth, cardH) x += DayCardWidth + CardGap End If Next scrollDays.Relayout() End Sub
End Class
