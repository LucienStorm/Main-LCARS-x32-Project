version="9"
logging="no"
name="LCARS Test Move"
enabled="yes"
type="1"
action="Move to folder"
actionValue="imap://user@mail.example.com/INBOX/LCARS"
action="Mark read"
condition="AND (from,contains,alerts@example.com)"
name="LCARS Test Subject"
enabled="yes"
type="1"
action="Stop execution"
condition="AND (subject,contains,SPAM)"
