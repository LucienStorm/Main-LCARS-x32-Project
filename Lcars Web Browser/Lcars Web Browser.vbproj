  <Import Project="$(MSBuildToolsPath)\Microsoft.VisualBasic.targets" />
  <!-- Do not import WebView2.targets: requires newer MSBuild than Framework 4.0 MSBuild. -->
  <PropertyGroup>
    <_Wv2SdkDir>$(ProjectDir)packages\Microsoft.Web.WebView2.1.0.4129.50\</_Wv2SdkDir>
    <_Wv2LoaderSrc>$(_Wv2SdkDir)runtimes\win-x86\native\WebView2Loader.dll</_Wv2LoaderSrc>
  </PropertyGroup>
  <Target Name="EnsureWebView2Sdk" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(_Wv2SdkDir)lib\net462\Microsoft.Web.WebView2.WinForms.dll')">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)..\tools\Restore-WebView2Sdk.ps1&quot;" />
    <Error Condition="!Exists('$(_Wv2SdkDir)lib\net462\Microsoft.Web.WebView2.WinForms.dll')" Text="Automatic WebView2 SDK restore from nuget.org failed. Check internet access and retry the build." />
  </Target>
  <Target Name="CopyWebView2Loader" AfterTargets="Build" Condition="Exists('$(_Wv2LoaderSrc)')">
    <Copy SourceFiles="$(_Wv2LoaderSrc)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
